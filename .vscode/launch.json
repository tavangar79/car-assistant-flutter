{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "car-assistant (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "args": ["--web-port=5555", "--dart-define-from-file=dart_defines.dev.json"],
      "env": { "NO_PROXY": "localhost" }
    }
  ]
}
