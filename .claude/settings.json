{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart fix --dry-run:*)",
      "Bash(graphify:*)",
      "mcp__stitch__*",
      "Bash(flutter pub add:*)",
      "Bash(flutter pub remove:*)",
      "Bash(flutter gen-l10n:*)",
      "Bash(dart fix --apply:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "defaultMode": "acceptEdits",
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}
